# Cùng URL ngrok với backend (ngrok http 3000 → proxy /api sang port 9999)
REACT_APP_API_URL=https://calcium-delirious-sneezing.ngrok-free.dev

# Cho phép truy cập React qua domain ngrok
DANGEROUSLY_DISABLE_HOST_CHECK=true
HOST=0.0.0.0

# Skip ngrok browser warning
REACT_APP_NGROK_SKIP_BROWSER_WARNING=true
