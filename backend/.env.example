MONGO_URI=mongodb://127.0.0.1:27017/tiktok_app
PORT=9999
JWT_SECRET=your_secret_key_change_me

# Ngrok: ngrok http 3000 — dùng cùng một URL cho 3 biến dưới (thay YOUR... bằng URL thật)
FRONTEND_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
TIKTOK_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/api/auth/tiktok/callback

TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.publish
TIKTOK_SANDBOX=true
